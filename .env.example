# Copy to .env for local development. On a VPS put these in the systemd unit,
# on Vercel in Project → Settings → Environment Variables.

# Owner password for the first sign-in (min 10 chars). Choose your own value.
# After the first sign-in the hash lives in the database; change it in Cabinet → Доступ.
NUXT_ADMIN_PASSWORD=

# Database. Leave empty to use the built-in database file (PGlite) in DATA_DIR,
# like the confectioner template's SQLite. Required on Vercel (e.g. Neon/Supabase).
DATABASE_URL=

# Folder for the built-in database and generated secret. Default: ./.data
DATA_DIR=

# Random string (32+ chars) for hashing client IPs. If empty, generated once into DATA_DIR/secret.
NUXT_SECRET=

# Public site URL: sitemap, canonical links and the origin check.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
