# Copy to .env for local development. On Vercel set these in Project → Settings → Environment Variables.

# PostgreSQL connection string (required in production, e.g. Neon/Supabase).
# Leave empty locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Owner password for the first sign-in (min 10 chars). Choose your own value.
# After the first sign-in the hash lives in the database; change it in Cabinet → Доступ.
NUXT_ADMIN_PASSWORD=

# Random string (32+ chars) used to hash client IPs for rate limiting. Required in production.
NUXT_SECRET=

# Public site URL: sitemap, canonical links and the origin check.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
